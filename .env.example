# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
# See DEPLOY.md for how to get each of these from the Cloudflare dashboard.

# From Zero Trust -> Networks -> Tunnels -> (your tunnel) -> the token shown
# when creating it.
TUNNEL_TOKEN=

# Local-dev-only auth bypass: every request is treated as authenticated as
# this literal email, no Cloudflare needed at all. Leave EMPTY in production
# — set, it disables all real authentication.
DEV_USER=

# Your Access team domain, e.g. "myteam.cloudflareaccess.com" (Zero Trust ->
# Settings -> Custom Pages, or just the URL of your team's Access login page).
CF_TEAM_DOMAIN=

# Only needed for the in-app Admin page's invite/disable/enable buttons
# (calls the Cloudflare API directly instead of you editing the policy by
# hand in the dashboard). Create an API Token (My Profile -> API Tokens)
# with Access: Access: Organizations, Identity Providers, and Groups Edit
# (or the narrower Access: Apps and Policies edit permission) scoped to your
# account.
CF_API_TOKEN=
# Zero Trust -> any page -> the account id is in the URL, or Account Home.
CF_ACCOUNT_ID=
# The specific Access Policy's id (the policy you attach to health.me's
# Access Application) — visible in that policy's URL in the dashboard, or
# via `GET /accounts/{account_id}/access/policies`.
CF_ACCESS_POLICY_ID=
