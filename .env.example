# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.

# Tailscale auth key for the container's first start — generate a reusable
# key at https://login.tailscale.com/admin/settings/keys (a tag like
# tag:health-me is ideal so ACLs can target it). After the first successful
# start the node identity lives in the tailscale-state volume and this key
# may expire.
TS_AUTHKEY=
